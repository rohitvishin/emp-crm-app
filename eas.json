{
  "cli": {
    "version": ">= 16.19.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
     "android": {
        "buildType": "apk"
      }
    },
    "apk": {
      "releaseChannel": "apk",
      "distribution": "internal",  // internal/test
      "android": {
        "buildType": "apk"         // 👈 forces .apk output
      }
    }
  },
  "submit": {
    "production": {}
  }
}
